{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lastfm-artist-overlap",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-10",
  "secrets": {
    "required": ["LASTFM_API_KEY"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
